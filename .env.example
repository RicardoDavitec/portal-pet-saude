# Copie para .env (nunca versionar .env).

POSTGRES_USER=portal
POSTGRES_PASSWORD=troque-me
POSTGRES_DB=portal_pet_saude
DATABASE_URL=postgresql://portal:troque-me@127.0.0.1:5500/portal_pet_saude

# LDAP municipal (F2.S2) — obter com o DTI
LDAP_URL=ldaps://ad.exemplo.local:636
LDAP_BASE_DN=DC=exemplo,DC=local
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(sAMAccountName={{username}})

# Adapter G1
G1_DASHBOARD_API_URL=http://127.0.0.1:3813
