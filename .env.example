# Copie para .env (nunca versionar .env).

POSTGRES_USER=portal
POSTGRES_PASSWORD=troque-me
POSTGRES_DB=portal_pet_saude
DATABASE_URL=postgresql://portal:troque-me@127.0.0.1:5500/portal_pet_saude

# Auth: dev | ldap
AUTH_MODE=dev

# LDAP municipal (AUTH_MODE=ldap) — obter com o DTI
LDAP_URL=ldaps://ad.exemplo.local:636
LDAP_BASE_DN=DC=exemplo,DC=local
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(sAMAccountName={{username}})

# G1: profiles do compose — g1-mock (padrão) | g1-real (Nest Dashboard)
COMPOSE_PROFILES=g1-mock
# Adapter G1 (host / docker)
G1_DASHBOARD_API_URL=http://127.0.0.1:3813
G1_DASHBOARD_API_URL_DOCKER=http://g1-mock:3813
# Com g1-real: G1_DASHBOARD_API_URL_DOCKER=http://g1-dashboard:3813
# G1_SERVICE_TOKEN = JWT Nest (tools/g1-nest/issue-service-token.sh)
G1_SERVICE_TOKEN=

CORS_ORIGINS=http://127.0.0.1:3862,http://localhost:3862,https://petsaude.franca.sp.gov.br
